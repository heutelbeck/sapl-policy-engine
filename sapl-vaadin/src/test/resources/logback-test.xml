<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<configuration>
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger - %msg%n</pattern>
		</encoder>
	</appender>

	<!-- Tests drive failure paths on purpose and the build console stays quiet.
	     Raise the root level to read the log while debugging a test. -->
	<root level="OFF">
		<appender-ref ref="STDOUT" />
	</root>
</configuration>
