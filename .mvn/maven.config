# -T 1C
-Dmaven.artifact.threads=5
-Daether.connector.basic.threads=5
# --fail-at-end
-Daether.connector.http.retryHandler.count=3
-Daether.connector.http.retryHandler.requestSentEnabled=true
-Daether.connector.connectTimeout=30000
-Daether.connector.requestTimeout=120000
-Daether.transport.http.retryHandler.count=3
-Daether.transport.apache.retryHandler.requestSentEnabled=true
-Daether.transport.http.connectTimeout=30000
-Daether.transport.http.requestTimeout=120000
