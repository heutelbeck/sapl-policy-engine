<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="DISCARD" class="ch.qos.logback.core.helpers.NOPAppender"/>

    <!-- Tests deliberately drive these into error/retry paths and assert on
         captured events via a ListAppender. Kept off the console. -->
    <logger name="io.sapl.pdp.remote.RemoteHttpReactivePolicyDecisionPoint" level="WARN" additivity="false">
        <appender-ref ref="DISCARD"/>
    </logger>
    <logger name="io.sapl.pdp.remote.RemotePdpRetry" level="WARN" additivity="false">
        <appender-ref ref="DISCARD"/>
    </logger>

    <!-- Tests drive failure paths on purpose and the build console stays quiet.
         Raise the root level to read the log while debugging a test. The
         integration tests forward the output of the node container to the
         logger of their test class at INFO. -->
    <root level="OFF">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
